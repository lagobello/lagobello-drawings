<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Lago Bello Shared Styles</name>

    <Style id="lotsStyle">
      <LineStyle><color>ff000000</color><width>2.5</width></LineStyle>
      <PolyStyle><color>80ff0000</color><fill>1</fill></PolyStyle>
    </Style>

    <Style id="rowStyle">
      <LineStyle><color>ff00a5ff</color><width>3</width></LineStyle>
      <PolyStyle><fill>0</fill></PolyStyle>
    </Style>

    <Style id="caminataStyle">
      <LineStyle><color>ff00ff00</color><width>3.5</width></LineStyle>
      <PolyStyle><fill>0</fill></PolyStyle>
    </Style>

    <Style id="greenFill">
      <LineStyle><color>ff000000</color><width>2</width></LineStyle>
      <PolyStyle><color>8000ff00</color><fill>1</fill></PolyStyle>
    </Style>

    <Style id="defaultStyle">
      <LineStyle><color>ff0000ff</color><width>1</LineStyle>
      <PolyStyle><fill>0</fill></PolyStyle>
    </Style>

  </Document>
</kml>